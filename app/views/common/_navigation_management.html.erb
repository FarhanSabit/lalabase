<%# locals: (current_organisation:) %>
<%# The sidebar while a page of the management area is open (user, 2026-11-11;
    doc/verwaltung_seitennavigation_plan.md): it lists the sections instead of the
    app's entries and projects, the frame around it (logo, organisation header with
    the gear, the utility row, the user menu) stays. "‹ Zurück" leads out, to the app
    page the reader came from (Organisations::ManagementReturn), the dashboard
    without one. The sections come from NavigationHelper::SETTINGS_TABS, in blocks
    by `group:` with a hairline between; a page below a section keeps the section
    marked (management_section_key). Rows are the sidebar's own
    (common/_navigation_item, SidebarNavHelper), so a section looks like Inbox when
    it is open. %>
<% active_key = management_section_key %>
<div class="w-full px-4 pt-3">
  <ul class="flex flex-col gap-1">
    <%= render 'common/navigation_item', name: t('navigation.management_back'),
                                         path: management_return_path(current_organisation), icon: 'bi bi-arrow-left' %>
  </ul>
  <p class="px-3 pb-1.5 pt-5 font-mono text-[11px] font-semibold uppercase tracking-[0.14em] text-muted"><%= t('navigation.management') %></p>
  <nav aria-label="<%= t('navigation.management') %>" data-management-nav>
    <% organisation_settings_tabs(current_organisation).chunk_while { |a, b| a[:group] == b[:group] }.each_with_index do |group, index| %>
      <% if index.positive? %>
        <hr class="mx-3 my-2 border-cream-300">
      <% end %>
      <ul class="flex flex-col gap-1">
        <% group.each do |section| %>
          <%= render 'common/navigation_item', name: section[:label], path: section[:path], icon: "bi #{section[:icon]}",
                                               active: section[:key] == active_key,
                                               trailing_icon: ('bi bi-arrow-up-right' if section[:leaves]) %>
        <% end %>
      </ul>
    <% end %>
  </nav>
</div>
