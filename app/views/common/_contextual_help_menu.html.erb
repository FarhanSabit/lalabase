<%# Contextual-help "?" trigger for a page area (doc/kontexthilfe_plan.md).
    Local: context (Symbol) — looked up in Docs::ContextualHelp::QUESTIONS.
    Renders nothing if the context has no curated questions (OverflowMenuComponent#render?).
    Each question opens the answer in the body-level slide-over drawer
    (doc/kontexthilfe_drawer_plan.md, D4): the Stimulus action carries the frame
    URL (page WITHOUT anchor) + the locale-resolved anchor as action params; the
    href stays the full slug#anchor deep link as no-JS fallback.
    The trigger takes the height of its row (F40 of the Belegungstabelle):
    size: :medium (default, 32 px) beside the head buttons (F1/F2) or alone,
    size: :large (40 px) only beside the 40 px groove of the view switch (F8)
    or a big gear; the 30 px icon pair of the tickets is no groove,
    quiet: true for the borderless 28 px trigger beside a "···" (inbox,
    members). Pinned per page by spec/requests/contextual_help_menu_spec.rb. %>
<%= render Neo::OverflowMenuComponent.new(
      icon: 'question-lg',
      trigger_label_key: 'components.contextual_help.label',
      size: local_assigns.fetch(:size, :medium),
      quiet: local_assigns.fetch(:quiet, false)
    ) do |menu| %>
  <% Docs::ContextualHelp.for(context).each do |question| %>
    <% slug   = question[:slug] %>
    <% anchor = Docs::ContextualHelp.anchor_for(question, I18n.locale) %>
    <%# The drawer can only show a page this instance has. Without a catalogue
        the question still helps: it links straight into the public
        documentation instead of opening a drawer onto nothing. %>
    <% menu.with_item(
         label: t(question[:label_key]),
         url: help_page_url(slug, anchor: anchor),
         icon: 'question-circle',
         data: (if help_available?
                  { action: 'contextual-help-drawer#open',
                    contextual_help_drawer_url_param: help_page_path(slug: slug),
                    contextual_help_drawer_anchor_param: anchor }
                else
                  { turbo: false }
                end)
       ) %>
  <% end %>
<% end %>
