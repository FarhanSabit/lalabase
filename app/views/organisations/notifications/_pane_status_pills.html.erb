<%# The actions of the open notification in the lane head: "Erledigt"
    archives it (the row leaves the list, the ticket stays open here, no jump
    to the next one), an icon flips read and unread, and an archived one
    offers the way back into the inbox. Then the link to the ticket's full
    view.
    Stable id "inbox_pane_status_pills": a state change swaps only this
    small area, never the whole lane (an open reply form would be lost).
    Locals: notification, current_organisation, project, ticket. %>
<div id="inbox_pane_status_pills" class="inbox-lane-actions">
  <%= link_to organisation_project_ticket_path(current_organisation, project, ticket),
              target: '_top', class: 'inbox-lane-actions__open' do %>
    <%= t('views.organisations.notifications.pane.open_full_view') %>
    <i class="bi bi-box-arrow-up-right" aria-hidden="true"></i>
  <% end %>

  <% if notification.state_archived? %>
    <%= button_to unarchive_organisation_notification_path(current_organisation, notification),
                  method: :patch, form: { data: { turbo_frame: '_top' }, class: 'contents' },
                  class: 'inbox-lane-actions__button' do %>
      <i class="bi bi-inbox" aria-hidden="true"></i>
      <%= t('views.organisations.notifications.pane.unarchive') %>
    <% end %>
  <% else %>
    <% read = notification.state_read? %>
    <% flip_label = t(read ? 'views.organisations.notifications.pane.mark_unread' : 'views.organisations.notifications.pane.mark_read') %>
    <%= button_to (read ? mark_unread_organisation_notification_path(current_organisation, notification)
                        : mark_read_organisation_notification_path(current_organisation, notification)),
                  method: :patch, form: { data: { turbo_frame: '_top' }, class: 'contents' },
                  class: 'inbox-lane-actions__icon', title: flip_label, 'aria-label': flip_label do %>
      <i class="bi bi-<%= read ? 'envelope' : 'envelope-open' %>" aria-hidden="true"></i>
    <% end %>
    <%= button_to archive_organisation_notification_path(current_organisation, notification),
                  method: :patch, form: { data: { turbo_frame: '_top' }, class: 'contents' },
                  class: 'inbox-lane-actions__button' do %>
      <i class="bi bi-archive" aria-hidden="true"></i>
      <%= t('views.organisations.notifications.pane.done') %>
    <% end %>
  <% end %>
</div>
