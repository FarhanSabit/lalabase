<%# The way out of the lane, as in the lane heads of "Personen" and "Alle
    Meetings": layout-toggle shuts the lane in place and takes the open
    notification out of the address. Below lg there is no lane (the inbox
    block of application.tailwind.css). %>
<span class="people-lane__divider" aria-hidden="true"></span>
<button type="button" class="people-icon-action"
        title="<%= t('views.organisations.notifications.pane.close') %>"
        aria-label="<%= t('views.organisations.notifications.pane.close') %>"
        data-lane-close data-action="click->layout-toggle#closeContent">
  <i class="bi bi-x-lg" aria-hidden="true"></i>
</button>
