<%# V1: only tickets get the pane pattern. Other notifiables (documents,
    posts, mentions without a ticket) get a hint and a link to the classic
    full view. See spec 4.6. %>
<%= render 'organisations/notifications/pane_notice',
           title: t('views.organisations.notifications.pane.non_ticket_title'),
           body: t('views.organisations.notifications.pane.non_ticket_subtitle'),
           link: (if @selected_notification
                    [t('views.organisations.notifications.pane.open_full_view'),
                     notification_deeplink_path(@selected_notification, source: 'inbox')]
                  end) %>
