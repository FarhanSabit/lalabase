<%# Bulk mark-all-read response. Uses the same master list refresh pattern
    as update.turbo_stream.erb, so that date headers and the empty state are
    re-rendered correctly. %>
<% presenter = build_master_list_presenter %>

<%= turbo_stream.replace 'inbox_master_list' do %>
  <%= render 'master_list',
             presenter: presenter,
             selected_notification: @selected_notification,
             query_context: presenter_query_context(presenter) %>
<% end %>

<%# The count in the "Ungelesen" pill of the list head. %>
<%= turbo_stream.replace 'inbox_unread_count' do %>
  <%= render 'organisations/notifications/unread_count', count: @unread_count %>
<% end %>

<%# Unread count: sidebar frame + count-data frame, one owner. %>
<%= render 'notifications/unread_count_streams', unread_count: @unread_count.to_i %>
