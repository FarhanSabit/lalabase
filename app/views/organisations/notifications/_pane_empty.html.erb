<%# Inbox lane without a chosen notification. The lane is shut then (the
    list takes the width), so this is seen only for a moment while a click
    loads the ticket. The frame itself must exist: the rows load into it. %>
<%= turbo_frame_tag 'ticket_pane', class: 'block' do %>
  <p class="inbox-lane-hint"><%= t('views.organisations.notifications.pane.empty_title') %></p>
<% end %>
