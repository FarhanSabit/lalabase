<%# locals: (presenter:) %>
<%# The inbox's view switch, in the page head before "···" and "?", in the one
    form of every view switch (NeoViewSwitchComponent, user 2026-11-11): the
    list first, as on the tickets and the time list. Its links carry the
    search, so the search's frame answer draws it again (index.html.erb), as
    it draws the tools row. me-2.5: the same air to "···" as the tickets'
    switch has to "?". %>
<div id="inbox_view_switch" class="me-2.5 flex items-center">
  <%= render NeoViewSwitchComponent.new(
    label: t('views.organisations.notifications.filter.view_label'),
    items: [%w[chronological list], %w[grouped stack]].map do |mode, icon|
      { key: mode.to_sym, icon: icon.to_sym, title: t("views.organisations.notifications.filter.view_#{mode}"),
        active: presenter.view_mode == mode, path: inbox_view_mode_url(mode) }
    end
  ) %>
</div>
