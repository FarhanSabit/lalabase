<%# locals: (title:, body:, link: nil) %>
<%# The lane when it cannot show a ticket (missing, not allowed, not a
    ticket): a title and a sentence in the lane's ordinary type, no symbol
    in a circle. link: [label, url] for the full view, optional. %>
<%= turbo_frame_tag 'ticket_pane', class: 'block' do %>
  <%# inbox-lane-content marks LOADED content for layout-toggle and index-page. %>
  <div class="inbox-lane-head__actions inbox-lane-head__actions--alone">
    <%= render 'organisations/notifications/pane_close' %>
  </div>
  <div class="inbox-lane-notice inbox-lane-content">
    <h2 class="inbox-lane-notice__title"><%= title %></h2>
    <p class="inbox-lane-notice__body"><%= body %></p>
    <% if link %>
      <%= link_to link.first, link.last, target: '_top', class: 'inbox-lane-notice__link' %>
    <% end %>
  </div>
<% end %>
