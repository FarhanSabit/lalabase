<%# "Was war neu": the unread activities of this ticket, newest on top. Gives
    back the context that the bundling in the list takes away. Snapshot on
    opening: stays visible after the delayed mark-read.
    Locals: new_activities (Array<Notification>). %>
<% if new_activities.present? %>
  <ul class="inbox-new-activity" aria-label="<%= t('views.organisations.notifications.pane.new_activity_label') %>">
    <% new_activities.each do |activity| %>
      <% line = Inbox::ActivityLine.new(activity) %>
      <li class="inbox-new-activity__item">
        <span class="inbox-new-activity__who"><%= line.actor_name %></span>
        <span class="inbox-new-activity__what"><%= line.label %></span>
        <span class="inbox-new-activity__time"><%= line.time_ago %></span>
      </li>
    <% end %>
  </ul>
<% end %>
