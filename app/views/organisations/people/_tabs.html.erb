<%# locals: (counts:) %>
<%# The three views of the directory as the ticket list draws its tabs (F10,
    the same classes: NeoFilterBarComponent.tab_classes), each with its count
    as a quiet number (the only place the counts stand). A tab is a full
    visit that keeps the search and the person open now (data-lane-keep,
    layout_toggle#syncFilterContext), as the tabs of "Alle Meetings" do. Its
    own id: the search's frame answer draws it again, because the links carry
    the search (_results). %>
<div id="people_list_tabs" role="tablist" aria-label="<%= t('views.organisations.people.index.filter_label') %>"
     class="flex items-end gap-0.5 min-w-0 overflow-x-auto scrollbar-hide -mb-px">
  <% People::Directory::KINDS.each do |kind| %>
    <% active = (list_state['kind'] || 'all') == kind %>
    <%= link_to organisation_people_path(@current_organisation, list_state.merge('kind' => (kind == 'all' ? nil : kind)).compact),
                role: 'tab', 'aria-selected': active.to_s, class: NeoFilterBarComponent.tab_classes(active),
                data: { turbo_frame: '_top', lane_keep: true } do %>
      <%= t("views.organisations.people.index.kinds.#{kind}") %>
      <span class="people-pill__count"><%= counts[kind] %></span>
    <% end %>
  <% end %>
</div>
