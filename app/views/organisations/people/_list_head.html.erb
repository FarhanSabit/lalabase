<%# locals: (counts:) %>
<%# The head of the list: the title, the main action, then the bar with the
    three views as tabs (their counts beside them) and the search. A tab is a
    full visit of the index, the search reloads the list frame; the open
    person stays open either way. Only the "+" carries the hard edge and the
    offset shadow. %>
<% frame_id = Organisations::PeopleController::DETAIL_FRAME_ID %>
<% mobile = @viewport_mode == 'mobile' %>
<% add_url = organisation_people_path(@current_organisation, list_state.merge('new' => Organisations::PeopleController::NEW_STATE)) %>
<% add_data = {
     controller: 'lane-link',
     action: 'click->lane-link#click',
     lane_link_url_value: new_organisation_person_path(@current_organisation),
     lane_link_frame_value: frame_id,
     lane_link_set_value: { new: Organisations::PeopleController::NEW_STATE }.to_json,
     lane_link_remove_value: %w[person_id member_id user_id].to_json,
     lane_link_focus_value: '#person_name'
   } %>
<%# The head on a desktop is the shared title box with the square primary
    "+" as its title action and the "?" of the contextual help, as on "Alle
    Meetings" and "Zeiten". On a phone the shell already names the page; the
    head keeps a larger square "+". %>
<div class="people-head">
  <% if mobile %>
    <% if policy(Person).create? %>
      <%= render Neo::Buttons::IconButtonComponent.new(variant: :primary, icon: 'plus-lg', size: :large, url: add_url,
                                                       title: t('views.organisations.people.index.new_person'),
                                                       class: 'people-head__action', data: add_data) %>
    <% end %>
  <% else %>
    <%= render NeoTitleBoxComponent.new(title: t('views.organisations.people.index.title'), variant: :organisation, margin_bottom: nil) do |box| %>
      <% if policy(Person).create? %>
        <% box.with_title_action do %>
          <%= render Neo::Buttons::IconButtonComponent.new(variant: :primary, icon: 'plus-lg', size: :medium, url: add_url,
                                                           title: t('views.organisations.people.index.new_person'), data: add_data) %>
        <% end %>
      <% end %>
      <% box.with_right_content do %>
        <%= render 'common/contextual_help_menu', context: :people %>
      <% end %>
    <% end %>
  <% end %>
</div>

<%# The bar of the ticket list, as on the inbox (user, 2026-11-11): the
    three views as its tabs on the row's divider, the search at the right
    end, a magnifier that grows into the field (.filter-bar lends the row the
    ticket list's search, components/filter_bar.css). %>
<div class="people-tools list-tab-bar filter-bar">
  <%= render 'organisations/people/tabs', counts: counts %>

  <%# The search answers while typing (NeoListSearchComponent, the inbox's):
      it reloads only the list frame, and layout-toggle writes the term into
      the address beside the person open now (people_page_data:
      list_frame_ids, list_filter_params), one entry of history; the row of
      that person marks itself from the address (list_row_controller). %>
  <%= render NeoListSearchComponent.new(
    url: organisation_people_path(@current_organisation), name: :q, value: list_state['q'],
    input_id: 'people-search', frame: Organisations::PeopleController::LIST_FRAME_ID, form_class: 'people-search',
    label: t('views.organisations.people.index.search_label'),
    placeholder: t('views.organisations.people.index.search_placeholder'),
    wrapper_class: 'ms-auto'
  ) do %>
    <%= hidden_field_tag :kind, list_state['kind'], id: nil if list_state['kind'] %>
    <%= hidden_field_tag :sort, list_state['sort'], id: nil if list_state['sort'] %>
    <%= hidden_field_tag :viewport, list_state['viewport'], id: nil if list_state['viewport'] %>
  <% end %>
</div>
