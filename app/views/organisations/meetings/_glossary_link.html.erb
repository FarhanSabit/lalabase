<%# locals: () %>
<%# The way into the glossary (user, 04.11.2026): the glossary serves the
    transcription of meetings, so it is reached from the head of the meetings
    pages ("Alle Meetings" and a project's meetings), not from the sidebar.
    Only for those who may read it (GlossaryPolicy). A link of the whole page:
    the head stands beside frames, and the glossary is a page of its own. %>
<% if policy(GlossaryTerm).index? %>
  <%= render Neo::Buttons::ButtonComponent.new(
    variant: :secondary,
    size: :medium,
    icon: 'book',
    url: organisation_glossary_terms_path(@current_organisation),
    data: { turbo_frame: '_top', meetings_glossary_link: true }
  ) do %>
    <%= t('navigation.glossary') %>
  <% end %>
<% end %>
