<%# locals: (edit_url: nil) %>
<%# The head of an open term: "Bearbeiten" for those who may keep the
    glossary, and the way out. The ✕ closes the lane in place
    (layout-toggle); on a phone the mobile view brings its own way back. %>
<div class="people-lane__head" data-lane-head data-lane-index-url="<%= organisation_glossary_terms_path(@current_organisation) %>">
  <% if edit_url %>
    <%= link_to edit_url, class: 'people-ghost-action' do %>
      <i class="bi bi-pencil" aria-hidden="true"></i><%= t('views.organisations.glossary.show.edit') %>
    <% end %>
  <% end %>
  <% unless @viewport_mode == 'mobile' %>
    <span class="people-lane__divider" aria-hidden="true"></span>
    <button type="button" class="people-icon-action" title="<%= t('views.organisations.glossary.show.close') %>"
            data-lane-close data-action="click->layout-toggle#closeContent">
      <i class="bi bi-x-lg" aria-hidden="true"></i>
    </button>
  <% end %>
</div>
