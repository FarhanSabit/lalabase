<%# locals: (correction:, term:, meetings:, can_write:) %>
<%# One correction of a heard form: who spoke (a name, a link only with
    view_people), the project it came from (a name for every reader of the
    glossary), the meeting (title and link only when the reader may read it,
    meetings holds those), the date, how often it was replaced, and delete for
    those who may keep the glossary. %>
<% speaker = glossary_speaker_name(correction) %>
<% speaker_url = glossary_speaker_url(correction) if speaker %>
<% meeting_title = meetings[correction.meeting_id] %>
<li class="glossary-heard__row">
  <span class="glossary-heard__speaker">
    <% if speaker_url %>
      <%= link_to speaker, speaker_url, class: 'people-fields__link', data: { turbo_frame: '_top' } %>
    <% elsif speaker %>
      <%= speaker %>
    <% else %>
      <span class="text-muted"><%= t('views.organisations.glossary.show.no_speaker') %></span>
    <% end %>
  </span>
  <span class="glossary-heard__origin">
    <%= correction.project&.name || t('views.organisations.glossary.show.no_project') %>
    <% if meeting_title %>
      · <%= link_to meeting_title, organisation_meetings_path(@current_organisation, meeting_id: correction.meeting_id),
                    class: 'people-fields__link', data: { turbo_frame: '_top' } %>
    <% end %>
  </span>
  <span class="glossary-heard__when">
    <time datetime="<%= correction.created_at.iso8601 %>"><%= l(correction.created_at.to_date, format: :default) %></time>
    <% if correction.replaced_count > 1 %>
      · <%= t('views.organisations.glossary.show.replaced', count: correction.replaced_count) %>
    <% end %>
  </span>
  <% if can_write %>
    <%= render Neo::Buttons::ButtonComponent.new(
      variant: :ghost, size: :small, icon: 'trash',
      title: t('views.organisations.glossary.show.delete_heard', heard: correction.heard),
      confirm: t('views.organisations.glossary.show.delete_heard_confirm', heard: correction.heard, term: term.term),
      form: { action: correction_organisation_glossary_term_path(@current_organisation, term, correction_id: correction.id),
              method: :delete, params: list_state, data: { turbo_frame: '_top' } }
    ) do %>
      <span class="sr-only"><%= t('views.organisations.glossary.show.delete_heard', heard: correction.heard) %></span>
    <% end %>
  <% end %>
</li>
