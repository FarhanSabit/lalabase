<%# The glossary of the organisation (Organisations::GlossaryController, K4a):
    the terms on the left, a term or the form in the lane on the right, the
    shape of the people directory. layout-toggle and index-page own the
    address (?term_id=, ?new=term, ?new=import); a write leaves the lane and lands here
    again. With ?view=proposals the list is the review list of the extraction
    (K5b) and a proposal opens in the lane (?proposal_id=). %>
<% content_for :head do %>
  <meta name="turbo-cache-control" content="no-cache">
<% end %>

<% lane_state = if @import then :import elsif @form_term then :form elsif @lane_term then :detail elsif @lane_proposal then :proposal end %>
<% lane_term = @form_term || @lane_term %>

<div class="labor-layout-view people-page glossary-page <%= 'show-content' if lane_state %> hide-panel"
     <%= tag.attributes(data: glossary_page_data(viewport_mode: @viewport_mode, term: @lane_term, proposal: @lane_proposal,
                                                 form_open: @form_term.present? || @import.present?)) %>>
  <% list = capture do %>
    <%= render 'organisations/glossary/list_head', status_counts: @status_counts, origin_projects: @origin_projects,
                                                   proposal_counts: @proposal_counts %>
    <%= render 'organisations/glossary/results', entries: @entries, status_counts: @status_counts,
                                                 selected: (glossary_proposals_view? ? @lane_proposal : @lane_term), run: @last_run %>
  <% end %>
  <% lane = capture do %>
    <%= render 'organisations/glossary/lane', state: lane_state || :empty, term: lane_term, import: @import,
                                              proposal: @lane_proposal, message: @form_message %>
  <% end %>

  <% if @viewport_mode == 'mobile' %>
    <%= render 'organisations/glossary/index_mobile', list: list, lane: lane, open: lane_state.present? %>
  <% else %>
    <%= render 'organisations/glossary/index_desktop', list: list, lane: lane, open: lane_state.present? %>
  <% end %>
</div>
