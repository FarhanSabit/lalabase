<%# locals: (proposal:) %>
<%# The decisions on a proposal from its row (K5b), like _status_actions:
    "Übernehmen" and "Verwerfen" while it is open, "Zurückholen" once it is
    dismissed; an accepted one has none. "Übernehmen" takes the proposal as
    it is, with all its other spellings as heard forms: what the lane's form
    does when nothing is changed there. Each button names its proposal for a
    screen reader: in the list, several stand one below the other. The
    filters ride along, and every write leaves the frame (_top). %>
<% name = t('views.organisations.glossary.quoted', text: proposal.term) %>
<% scope = 'views.organisations.glossary.proposals' %>
<% if proposal.open? || proposal.dismissed? %>
  <div class="glossary-status-actions">
    <% if proposal.open? %>
      <%= render Neo::Buttons::ButtonComponent.new(
        variant: :secondary, size: :small, icon: 'check-lg',
        form: { action: accept_proposal_organisation_glossary_terms_path(@current_organisation, proposal_id: proposal.id),
                method: :patch, data: { turbo_frame: '_top' },
                params: list_state.merge('proposal' => { 'term' => proposal.term, 'variants' => proposal.variants }) }
      ) do %>
        <%= t("#{scope}.accept") %><span class="sr-only"> <%= name %></span>
      <% end %>
      <%= render Neo::Buttons::ButtonComponent.new(
        variant: :secondary, size: :small, icon: 'x-lg',
        form: { action: dismiss_proposal_organisation_glossary_terms_path(@current_organisation, proposal_id: proposal.id),
                method: :patch, params: list_state, data: { turbo_frame: '_top' } }
      ) do %>
        <%= t("#{scope}.dismiss") %><span class="sr-only"> <%= name %></span>
      <% end %>
    <% else %>
      <%= render Neo::Buttons::ButtonComponent.new(
        variant: :secondary, size: :small, icon: 'arrow-counterclockwise',
        form: { action: restore_proposal_organisation_glossary_terms_path(@current_organisation, proposal_id: proposal.id),
                method: :patch, params: list_state, data: { turbo_frame: '_top' } }
      ) do %>
        <%= t("#{scope}.restore") %><span class="sr-only"> <%= name %></span>
      <% end %>
    <% end %>
  </div>
<% end %>
