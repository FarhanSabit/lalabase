<%# locals: (list:, lane:, open:) %>
<%# Mobile: the list, or the term (or the form, or a proposal) full screen
    with a way back to the list it came from, as on the people page. Same
    frame id as on the desktop. %>
<% back_label = glossary_proposals_view? ? t('views.organisations.glossary.proposals.review_list') : t('views.organisations.glossary.index.back_to_list') %>
<div class="people-mobile-grid list">
  <%= render NeoMobileTicketViewComponent.new(
    selected_item: (open || nil),
    show_detail: open,
    back_url: organisation_glossary_terms_path(@current_organisation, list_state),
    back_label: back_label
  ) do |mobile| %>
    <% mobile.with_list do %>
      <%= list %>
    <% end %>

    <% mobile.with_detail do %>
      <turbo-frame id="<%= Organisations::GlossaryController::DETAIL_FRAME_ID %>">
        <%= lane %>
      </turbo-frame>
    <% end %>
  <% end %>
</div>
