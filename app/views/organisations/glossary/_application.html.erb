<%# locals: (application:, meetings:) %>
<%# One application of a heard form (K4d): the recording app replaced it by the term
    when it sent a meeting. No speaker: the device sends none (E9). The project for
    every reader of the glossary, the meeting's title and link only for a reader of it
    (meetings holds those), the date and how often. Nothing to decide or delete here:
    the row is a trace of what happened, it goes with its meeting. %>
<% meeting_title = meetings[application.meeting_id] %>
<li class="glossary-heard__row glossary-heard__row--applied">
  <span class="glossary-heard__speaker"><%= t('views.organisations.glossary.show.applied_row') %></span>
  <span class="glossary-heard__origin">
    <%= application.project&.name || t('views.organisations.glossary.show.no_project') %>
    <% if meeting_title %>
      · <%= link_to meeting_title, organisation_meetings_path(@current_organisation, meeting_id: application.meeting_id),
                    class: 'people-fields__link', data: { turbo_frame: '_top' } %>
    <% end %>
  </span>
  <span class="glossary-heard__when">
    <time datetime="<%= application.created_at.iso8601 %>"><%= l(application.created_at.to_date, format: :default) %></time>
    · <%= t('views.organisations.glossary.show.replaced', count: application.replaced_count) %>
  </span>
</li>
