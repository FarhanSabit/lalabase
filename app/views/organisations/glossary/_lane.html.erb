<%# locals: (state:, term: nil, import: nil, proposal: nil, message: nil) %>
<%# What the lane frame holds: a term (:detail), the form (:form, new or
    edit), the import of a pasted list (:import, its textarea; :import_preview,
    its check, K5), a proposal of the extraction (:proposal, K5b), or nothing
    yet (:empty). import is the controller's ImportDraft: the text and, once
    checked, the report. Rendered by the index on a full visit and alone for
    a frame request. glossary-content marks LOADED content for layout-toggle
    and index-page; the empty lane must not carry it, or they open an empty
    column. %>
<div class="<%= 'glossary-content' unless state == :empty %> people-lane min-w-0 relative">
  <% if state == :detail %>
    <%= render 'organisations/glossary/detail', term: term %>
  <% elsif state == :form %>
    <%= render 'organisations/glossary/form', term: term, message: message %>
  <% elsif state == :import %>
    <%= render 'organisations/glossary/import_form', text: import.text, message: message %>
  <% elsif state == :import_preview %>
    <%= render 'organisations/glossary/import_preview', text: import.text, report: import.report %>
  <% elsif state == :proposal %>
    <%= render 'organisations/glossary/proposal_detail', proposal: proposal %>
  <% else %>
    <div id="glossary-term-placeholder" class="ticket-placeholder px-4 py-10 text-center">
      <h2 class="text-lg font-semibold text-heading"><%= t(glossary_placeholder_key(:title)) %></h2>
      <p class="text-sm text-muted"><%= t(glossary_placeholder_key(:body)) %></p>
    </div>
  <% end %>
</div>
