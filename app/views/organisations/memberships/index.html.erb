<% content_for :head do %>
  <meta name="turbo-cache-control" content="no-cache">
<% end %>
<%# One block for head and workspace: the content column of the layout puts its gap
    (gap-6) between its children, and head and tab row are one thing. %>
<div>
<% can_manage_members = current_user.account_admin_in?(@current_organisation) %>
<%# The head of the section (doc/verwaltung_seitennavigation_plan.md §5): the
    count beside the title, the help and the "+" (invite) right, as on every page;
    the access overview is the section's second tab. The head stands outside the
    workspace frame, so a search or a sort leaves it alone. %>
<% head_tools = capture do %>
  <%= render 'common/contextual_help_menu', context: :settings_members %>
<% end %>
<% invite = capture do %>
  <% if can_manage_members %>
    <%= render Neo::Buttons::IconButtonComponent.new(variant: :primary, icon: 'plus-lg', size: :medium,
                                                     url: new_organisation_invitation_path(@current_organisation),
                                                     title: t('member_management.invite')) %>
  <% end %>
<% end %>
<%= render 'organisations/shared/settings_subnav', active: :members, badge: tag.span(@member_count, id: 'members_count'),
                                                   tabs: members_section_tabs(@current_organisation), tab_active: :members,
                                                   right_content: head_tools, title_action: invite.presence %>
<%= turbo_frame_tag 'members_workspace', data: { controller: 'membership-workspace', action: 'click->membership-workspace#navigate keydown.esc->membership-workspace#closePanel click@document->membership-workspace#closeOutside popstate@window->membership-workspace#restore turbo:frame-load->membership-workspace#restoreFocus' } do %>
  <%# The head stays outside this frame; mutations still refresh its total. %>
  <%= turbo_stream.update 'members_count', @member_count if turbo_frame_request? %>
  <%# What stays above the list: the way to the pending invitations and, from twelve
      members on, the search. Neither, no row. %>
  <% show_search = @member_count >= 12 || params[:q].present? %>
  <% show_invitations = can_manage_members && @invitations.any? %>
  <% if show_search || show_invitations %>
    <div class="members-toolbar">
      <p class="text-sm text-muted">
        <% if show_invitations %>
          <%= link_to t('member_management.invitation_count', count: @invitations.size), '#pending-invitations', class: 'hover:underline' %>
        <% end %>
      </p>
      <div class="members-tools">
        <% if show_search %>
          <%= form_with url: organisation_memberships_path(@current_organisation), method: :get, class: 'members-search', data: { action: 'submit->membership-workspace#search' } do |form| %>
            <% membership_list_params.except(:q).each do |key, value| %><%= hidden_field_tag key, value %><% end %>
            <%= form.search_field :q, value: params[:q], placeholder: t('member_management.search'), 'aria-label': t('member_management.search'), class: 'members-search-input' %>
            <button type="submit" class="members-more" title="<%= t('member_management.search') %>" aria-label="<%= t('member_management.search') %>"><i class="bi bi-search" aria-hidden="true"></i></button>
          <% end %>
        <% end %>
      </div>
    </div>
  <% end %>
  <% if flash[:notice].present? || flash[:alert].present? %><p class="mb-3 text-sm text-muted" role="status"><%= flash[:alert] || flash[:notice] %></p><% end %>
  <% if flash[:warning].present? %><p class="mb-3 text-sm text-muted" role="status"><%= flash[:warning] %></p><% end %>
  <div class="members-layout <%= 'members-layout--open' if @membership %>" data-membership-workspace-url="<%= membership_list_path %>">
    <div class="members-list">
      <table class="members-table">
        <thead><tr>
          <% %w[name role since].each do |column| %>
            <th scope="col" class="column-head members-col-<%= column %>" aria-sort="<%= (params[:sort].presence || 'name') == column ? (params[:direction] == 'desc' ? 'descending' : 'ascending') : 'none' %>">
              <%= link_to membership_sort_path(column) do %>
                <%= t("member_management.#{column}") %><% if (params[:sort].presence || 'name') == column %> <span aria-hidden="true"><%= params[:direction] == 'desc' ? '↓' : '↑' %></span><% end %>
              <% end %>
            </th>
          <% end %>
          <% if can_manage_members %>
            <th scope="col" class="column-head members-col-actions"><span class="sr-only"><%= t('member_management.actions') %></span></th>
          <% end %>
        </tr></thead>
        <tbody>
          <% @memberships.each do |membership| %>
            <%= render 'member', membership: membership, can_manage_members: can_manage_members %>
          <% end %>
        </tbody>
      </table>
      <% if @memberships.empty? %>
        <p class="py-6 text-sm text-muted"><%= t('member_management.empty') %></p>
      <% end %>
      <% if can_manage_members && @invitations.any? %><%= render 'invitations' %><% end %>
    </div>
    <% if @membership %><%= render 'panel', membership: @membership %><% end %>
  </div>
<% end %>
</div>
