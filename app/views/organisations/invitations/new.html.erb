<%# A page below the members' list (doc/verwaltung_seitennavigation_plan.md §5): the
    section's head with its tabs, "Mitglieder" marked as the parent, then the crumb back
    to the list, the only way back. No padding of its own above the head: the title
    stands where every page puts it (page_title_edge_spec). Head, crumb and form in one
    block: the layout's content column puts a gap between its children. The form has
    no top margin: the crumb holds the distance below the tab row. %>
<div>
  <%= render 'organisations/shared/settings_subnav', active: :members,
                                                     tabs: members_section_tabs(@current_organisation), tab_active: :members,
                                                     below_tab: true %>
  <%= render 'organisations/shared/section_crumb', back_label: t('settings.members'),
                                                   back_path: organisation_memberships_path(@current_organisation),
                                                   page: t('.title') %>

  <div class="max-w-2xl">
    <%= form_with model: [@current_organisation, @invitation], local: true do |form| %>
      <% if @invitation.errors.any? %>
        <div class="mb-4 p-4 bg-red-50 border-l-4 border-red-400 rounded">
          <div class="flex">
            <div class="flex-shrink-0">
              <i class="bi bi-exclamation-triangle text-red-400"></i>
            </div>
            <div class="ml-3">
              <h3 class="text-sm font-medium text-red-800">
                <%= t('.errors_prevent_save', count: @invitation.errors.count) %>
              </h3>
              <div class="mt-2 text-sm text-red-700">
                <ul class="list-disc list-inside">
                  <% @invitation.errors.full_messages.each do |message| %>
                    <li><%= message %></li>
                  <% end %>
                </ul>
              </div>
            </div>
          </div>
        </div>
      <% end %>

      <!-- Email field -->
      <div class="mb-4">
        <%= form.label :email, t('.email_label'), class: "block text-sm font-medium text-cream-700 mb-1" %>
        <%= form.email_field :email,
            class: "mt-1 block w-full px-3 py-2 bg-surface-raised border border-cream-300 rounded focus:outline-none focus:border-ink focus:ring-1 focus:ring-ink transition-all sm:text-sm",
            placeholder: t('.email_placeholder'),
            required: true %>
      </div>

      <%# D1: Send primary on the right, ButtonComponent (P4), size :large. No Cancel: it only
          led back to the list, and the crumb is that way back. %>
      <div class="flex items-center justify-end gap-3">
        <%= render Neo::Buttons::ButtonComponent.new(
          variant: :primary,
          size: :large,
          icon: "envelope",
          tag: :button,
          type: 'submit'
        ) do %>
          <%= t('.send_invitation') %>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
