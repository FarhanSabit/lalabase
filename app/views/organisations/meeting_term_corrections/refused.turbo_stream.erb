<%# The correction was refused, or the transcript changed since the dialog counted: the dialog
    again, in place of the opening that sent it, with what was typed and the count of the
    transcript stored now. A dialog closed meanwhile has no such element and stays closed.
    Without a usable token there is no opening to fill: the reason goes out as a flash. %>
<% if @modal_token %>
  <%= turbo_stream.replace term_correction_modal_instance_id(@meeting.id, @modal_token) do %>
    <%= render 'organisations/meeting_term_corrections/modal',
               meeting: @meeting, token: @modal_token, dialog: @dialog, fields: @fields, errors: @errors, notice: @notice %>
  <% end %>
<% else %>
  <% message = @notice ? t("views.organisations.meetings.term_correction.#{@notice}") : @errors.to_sentence %>
  <%= turbo_stream.prepend 'flash', partial: 'layouts/flash', locals: { flash: { alert: message } } %>
<% end %>
