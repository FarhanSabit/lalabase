<%# The dialog "Begriff korrigieren", loaded into its frame by the button over a mark in the
    transcript (layout: false, only the frame counts). See _modal. %>
<%= turbo_frame_tag term_correction_modal_id(@meeting.id) do %>
  <%= render 'organisations/meeting_term_corrections/modal', meeting: @meeting, token: @modal_token, dialog: @dialog %>
<% end %>
