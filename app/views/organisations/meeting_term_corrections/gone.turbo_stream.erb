<%# Not found: the meeting moved or was deleted (before the request: the lookup; during it: the
    lock). The dialog opening goes and the reason comes as a flash. Nothing of the meeting is
    drawn again: it may be in a project this request was not checked for. %>
<% if @modal_token %>
  <%= turbo_stream.remove term_correction_modal_instance_id(@meeting_id, @modal_token) %>
<% end %>
<%= turbo_stream.prepend 'flash', partial: 'layouts/flash', locals: { flash: { alert: @errors.to_sentence } } %>
