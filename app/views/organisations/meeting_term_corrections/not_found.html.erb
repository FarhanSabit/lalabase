<%# The meeting is no longer in this project (moved or deleted while the page was open). The
    answer goes into the dialog's frame, by the meeting id of the route, so the page says why
    instead of Turbo's "Content missing". Nothing of the meeting is drawn. %>
<%= turbo_frame_tag term_correction_modal_id(@meeting_id) do %>
  <p class="term-correction-gone mt-1 text-sm text-red-800" role="alert"><%= @errors.to_sentence %></p>
<% end %>
