<%# Corrected: the transcript drawn again, in full (the reader was looking at the place), the
    summary when the correction replaced the word in it too ("everywhere"), this opening of the
    dialog gone, and a flash with the number of places and what the glossary learnt. %>
<%= turbo_stream.replace meeting_transcript_section_id(@meeting) do %>
  <%= render 'organisations/meetings/transcript_section',
             meeting: @meeting, participants: @participants, clamp: false, correctable: true %>
<% end %>
<% if @summary_replaced %>
  <%= turbo_stream.replace "#{dom_id(@meeting)}_summary_section",
                           partial: 'organisations/meetings/summary_section', locals: { meeting: @meeting } %>
<% end %>
<% if @modal_token %>
  <%= turbo_stream.remove term_correction_modal_instance_id(@meeting.id, @modal_token) %>
<% end %>
<%= turbo_stream.prepend 'flash', partial: 'layouts/flash', locals: { flash: @flash_message } %>
