<%= tag.div(**wrapper_attributes) do %>
  <button type="button" data-fb-search-open-button data-action="click->search-disclosure#open"
          aria-label="<%= button_label %>" title="<%= button_label %>" class="<%= self.class::BUTTON_CLASSES %>">
    <i class="bi bi-search text-xs" aria-hidden="true"></i>
  </button>
  <%= form_with(**form_attributes) do %>
    <%= content %>
    <span class="absolute inset-y-0 left-0 flex items-center pl-2.5 pr-1 text-faint pointer-events-none" data-fb-depth>
      <i class="bi bi-search text-xs" aria-hidden="true"></i>
    </span>
    <%= search_field_tag name, value, autocomplete: 'off', **input_attributes %>
  <% end %>
<% end %>
