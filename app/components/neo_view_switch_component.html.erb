<%# Links are navigation (nav); buttons are a control group. %>
<%= content_tag(links_only? ? :nav : :div, class: container_classes, role: (links_only? ? nil : 'group'), 'aria-label': label) do %>
  <% items.each do |item| %>
    <% if item[:method] == :get %>
      <%= link_to item[:path], **tile_attributes(item), 'aria-current': (item[:active] ? 'page' : nil) do %>
        <%= icon_svg(item) %>
      <% end %>
    <% else %>
      <%= button_to item[:path],
                    params: item[:params],
                    method: item[:method],
                    form: { data: { turbo: false }, class: 'h-full' },
                    disabled: item[:disabled],
                    'aria-pressed': item[:active].to_s,
                    **tile_attributes(item) do %>
        <%= icon_svg(item) %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
